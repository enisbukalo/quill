    "checks": {"type": "array", "items": {"type": "object", "required": ["name", "state", "status", "conclusion", "url", "run_id"], "additional_properties": false, "properties": {
      "name": {"type": "string", "min_length": 1},
      "state": {"type": "string", "min_length": 1},
      "status": {"type": "string"},
      "conclusion": {"type": "string"},
      "url": {"type": "string"},
      "run_id": {"type": "string"},
      "failure_log": {"type": "string", "min_length": 1},
      "failure_log_sha256": {"type": "string", "min_length": 64}
    }}}
  }}
